# Database Configuration
# For SQLite (dev): sqlite+aiosqlite:///./invoice_ocr.db
# For PostgreSQL (prod): postgresql+asyncpg://user:password@localhost/invoice_ocr_db
DATABASE_URL=sqlite+aiosqlite:///./invoice_ocr.db

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production-min-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
API_TITLE=Invoice OCR API
API_VERSION=0.1.0
DEBUG=True

# Server Configuration
HOST=0.0.0.0
PORT=8000

# File Upload Configuration
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
UPLOAD_DIRECTORY=uploads/documents

# OCR Configuration
OCR_MODEL_CACHE_DIR=models

# Invoice OCR App - Environment Configuration
# Copy this file to .env and update the values

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Uploads
UPLOAD_DIR=uploads/documents
MAX_UPLOAD_SIZE=10485760

# OCR
OCR_LANG=en
OCR_USE_GPU=false
# NOTE: PaddleOCR auto-manages model downloads to ~/.paddleocr/whl/
# No need to specify model directories